<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="40dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:layout_marginBottom="6dp"
            android:scaleType="fitCenter"
            android:background="@drawable/barber_time" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BARBER TIME"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#F8F8F8"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- CARD DE LOGIN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="#181818"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bem-vindo"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#F8F8F8"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Entre na sua conta para continuar"
                    android:textSize="13sp"
                    android:textColor="#AAAAAA"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- LOGIN -->
                <EditText
                    android:id="@+id/inputLogEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingHorizontal="14dp"
                    android:hint="Login ou e-mail"
                    android:textColor="#F8F8F8"
                    android:textColorHint="#888888"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:autofillHints="username" />

                <!-- SENHA -->
                <EditText
                    android:id="@+id/inputLogSenha"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingHorizontal="14dp"
                    android:hint="Senha"
                    android:textColor="#F8F8F8"
                    android:textColorHint="#888888"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:autofillHints="password" />

                <!-- BOTÃO LOGIN -->
                <Button
                    android:id="@+id/btLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="LOGIN"
                    android:textColor="#121212"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:backgroundTint="#F8F8F8"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- CARD DE CADASTRO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#181818"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Novo aqui?"
                    android:textSize="14sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btTelaCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CADASTRE-SE"
                    android:textColor="#121212"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:backgroundTint="#F8F8F8"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
