<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#181818"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- DETALHE SUPERIOR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#F8F8F8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- DATA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATA DO AGENDAMENTO"
                android:textColor="#999999"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/txtItemData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="10/06/2025"
                android:textColor="#F8F8F8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- HORÁRIO -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#303030" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HORA AGENDADA"
                android:textColor="#999999"
                android:textSize="10sp"
                android:layout_marginTop="6dp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/txtItemHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="16:00"
                android:textColor="#F8F8F8"
                android:textStyle="bold"
                android:textSize="16sp" />

            <!-- DIVISOR -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#303030" />

            <!-- SERVIÇOS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="SERVIÇOS"
                android:textColor="#999999"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/txtItemServicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Corte, Barba"
                android:textColor="#F8F8F8"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- DADOS DO CLIENTE -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#303030" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DADOS DO CLIENTE (NOME E TELEFONE)"
                android:textColor="#999999"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtItemNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nome do cliente"
                    android:textColor="#F0F0F0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtItemTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Telefone do cliente"
                    android:textColor="#F0F0F0"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
