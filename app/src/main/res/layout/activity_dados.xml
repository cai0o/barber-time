<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dadosUsuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    tools:context=".DadosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- CABEÇALHO -->

        <!-- CARD PRINCIPAL -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#181818"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- TÍTULO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dados do Usuario"
                    android:textColor="#F8F8F8"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consulte as informações da sua conta"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginBottom="28dp" />

                <!-- NOME DE USUÁRIO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOME DE USUÁRIO"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtDadosUsername"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_login_input"
                    android:text="Seu usuário"
                    android:textColor="#F8F8F8"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginBottom="22dp" />

                <!-- E-MAIL -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ENDEREÇO DE E-MAIL"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtDadosEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:background="@drawable/bg_login_input"
                    android:text="seuemail@exemplo.com"
                    android:textColor="#F8F8F8"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginBottom="22dp" />

                <!-- SENHA -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SENHA"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_login_input"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:id="@+id/txtDadosSenha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="••••••••"
                        android:textColor="#F8F8F8"
                        android:textSize="16sp"
                        android:letterSpacing="0.12" />


                </LinearLayout>

                <!-- BOTÃO VOLTAR -->

                <Button
                    android:id="@+id/btVoltarMenu"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="VOLTAR AO MENU"
                    android:textColor="#121212"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:backgroundTint="#F8F8F8"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- RODAPÉ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="BARBER TIME  •  SEU ESTILO"
            android:textColor="#666666"
            android:textSize="10sp"
            android:letterSpacing="0.10" />

    </LinearLayout>

</ScrollView>
